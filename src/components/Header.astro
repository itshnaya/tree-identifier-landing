---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../lib/content.js';
import { withBase } from '../lib/paths.js';
import { paymentMode } from '../lib/premium.js';
const { nav } = site;
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 btn btn-mint">{nav.skip_link}</a>
<header class="sticky top-0 z-40 border-b border-forest/10 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <a href={withBase('/')} class="flex items-center gap-2.5 no-underline" aria-label={nav.home_label}>
      <Image src={logo} alt="" width={36} height={36} densities={[1, 2, 3]} class="rounded-[9px]" loading="eager" />
      <span class="font-display text-[1.2rem] font-semibold">{site.app_name}</span>
    </a>
    <a href={withBase(paymentMode ? '/premium/' : '/get/')} data-get-link class="btn btn-mint text-sm" data-source="header">{paymentMode ? site.premium.nav_cta : nav.cta}</a>
  </div>
</header>
