---
import StoreBadges from './StoreBadges.astro';
import { site } from '../lib/content.js';
import { isTBC } from '../lib/tbc.js';
import { showTBC } from '../lib/mode.js';
const f = site.footer;
const links = [
  { label: f.privacy_label, href: f.privacy_url },
  { label: f.terms_label, href: f.terms_url },
  { label: f.contact_label, href: f.contact_url },
].filter((l) => showTBC || !isTBC(l.href));
const socials = Object.values(site.social).filter((s) => showTBC || !isTBC(s.url));
---
<footer class="border-t border-white/10 bg-[#072B1D] pt-12 pb-[max(3rem,calc(2rem+env(safe-area-inset-bottom)))]">
  <div class="wrap grid gap-8 md:grid-cols-2">
    <div>
      <StoreBadges source="footer" />
      <p class="mt-6 font-semibold">{f.made_by}.</p>
    </div>
    <div class="grid gap-6 md:justify-items-end">
      {socials.length > 0 && <div>
        <p class="font-semibold md:text-right">{f.follow}</p>
        <ul class="mt-3 flex flex-wrap gap-3 md:justify-end">
          {socials.map((s) => (
            <li>{isTBC(s.url)
              ? <span class="btn btn-outline text-sm">{s.label} <span class="tbc">[À CONFIRMER]</span></span>
              : <a class="btn btn-outline text-sm" href={s.url} target="_blank" rel="noopener">{s.label}{!isTBC(s.handle) && ` ${s.handle}`}</a>}</li>
          ))}
        </ul>
      </div>}
      <ul class="-mx-2 flex flex-wrap gap-x-1 text-sm md:mx-0 md:justify-end">
        {links.map((l) => <li>{isTBC(l.href) ? <span class="inline-flex min-h-11 items-center gap-1 px-2">{l.label} <span class="tbc">[À CONFIRMER]</span></span> : <a href={l.href} class="inline-flex min-h-11 items-center px-2 underline" target="_blank" rel="noopener">{l.label}</a>}</li>)}
      </ul>
    </div>
  </div>
</footer>
