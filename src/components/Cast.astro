---
import CharacterPortrait from './CharacterPortrait.astro';
import { site, cast } from '../lib/content.js';
---
<section id="cast" class="section bg-forest-2" aria-labelledby="cast-title">
  <div class="wrap">
    <h2 id="cast-title" class="section-title">{site.cast.title}</h2>
    <p class="section-intro">{site.cast.intro}</p>
    <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {cast.map((c) => (
        <li class="card-light flex flex-col overflow-hidden">
          <CharacterPortrait character={c} size={240} />
          <div class="flex flex-1 flex-col p-4">
            <h3 class="text-[1.3rem] font-bold">{c.name}</h3>
            <p class="text-sm">{c.role}</p>
            <p class="mt-3 font-display text-[1.05rem] font-semibold">“{c.line}”</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
