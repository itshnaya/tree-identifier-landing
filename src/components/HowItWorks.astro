---
import { Picture } from 'astro:assets';
import { site } from '../lib/content.js';
const screens = import.meta.glob('../assets/screens/*.png', { eager: true });
const img = (name) => screens[`../assets/screens/${name}.png`].default;
const s = site.how_it_works;
---
<section id="how-it-works" class="section section-light" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="section-title">{s.title}</h2>
    <p class="section-intro">{s.intro}</p>
    <ol class="-mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:thin] md:mx-0 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0" tabindex="0" aria-label={s.title}>
      {s.steps.map((step, i) => (
        <li class="flex w-[78vw] max-w-[320px] shrink-0 snap-start flex-col md:w-auto md:max-w-none">
          <div class="flex items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-mint font-display text-lg font-bold text-forest" aria-hidden="true">{i + 1}</span>
            <h3 class="text-[1.45rem] font-semibold">{step.title}</h3>
          </div>
          <p class="mt-2 text-moss">{step.text}</p>
          <div class="mt-5 overflow-hidden rounded-[28px] border border-forest/10 bg-forest/5">
            <Picture src={img(step.image)} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[320, 480, 640]} sizes="(min-width: 768px) 340px, 78vw"
              alt={step.alt} loading="lazy" decoding="async" class="block aspect-[1287/1845] h-auto w-full" />
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-moss">{s.screens_note}</p>
  </div>
</section>
