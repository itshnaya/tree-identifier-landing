---
// Confirmed value → shown as is.
// [À CONFIRMER] (+ optional proposal) → badge + proposal in dev/preview, nothing in production.
import { isTBC, proposalOf, TBC } from '../lib/tbc.js';
import { showTBC } from '../lib/mode.js';
const { value, label } = Astro.props;
const tbc = isTBC(value);
const proposal = proposalOf(value);
---
{!tbc && <Fragment set:text={value} />}
{tbc && showTBC && (
  <>
    <span class="tbc" title="Information to confirm">{label ? `${label} ${TBC}` : TBC}</span>
    {proposal && <> <span class="proposal">{proposal}</span></>}
  </>
)}
