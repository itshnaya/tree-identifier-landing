---
// What the app does. Every line comes from the official App Store description
// (apps.apple.com/us/app/tree-identifier-id/id6752256800, read 2026-11-23).
import { site } from '../lib/content.js';
const f = site.features;
---
<section id="features" class="section bg-surface" aria-labelledby="features-title">
  <div class="wrap">
    <h2 id="features-title" class="section-title">{f.title}</h2>
    <p class="section-intro">{f.intro}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {f.items.map((it) => (
        <li class="rounded-3xl border border-forest/10 bg-white p-5 md:p-6">
          <span aria-hidden="true" class="grid size-12 place-items-center rounded-2xl bg-mint-light text-2xl">{it.icon}</span>
          <h3 class="mt-4 text-[1.3rem] font-semibold">{it.title}</h3>
          <p class="mt-1.5 text-muted">{it.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-muted">{f.premium_note}</p>
  </div>
</section>
