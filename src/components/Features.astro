---
// Features: only what BOTH official store descriptions list (App Store + Google Play,
// read on 2026-11-23). Platform-only extras are labelled per platform. Texts: site.json → features.
import { site } from '../lib/content.js';
const f = site.features;
// Simple line icons (decorative). Keys match "icon" in site.json → features.items.
const icons = {
  camera: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  health: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M9 11h6M12 8v6"/>',
  chat: '<path d="M5 5h14v10H10l-4 4v-4H5z"/><path d="M9 10h.01M12 10h.01M15 10h.01"/>',
  collection: '<path d="M7 4h10v16l-5-3.5L7 20z"/>',
  bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
  tools: '<circle cx="12" cy="12" r="3.5"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>',
};
---
<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <h2 id="features-title" class="section-title">{f.title}</h2>
    <p class="section-intro">{f.intro}</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4">
      {f.items.map((item) => (
        <li class="flex gap-4 rounded-3xl border border-white/12 bg-forest-2 p-5">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-mint text-forest" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon] || icons.camera} />
          </span>
          <div>
            <h3 class="text-[1.25rem] font-semibold">{item.title}</h3>
            <p class="mt-1 text-mint-light">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <h3 class="mt-10 text-[1.3rem] font-semibold">{f.platform_title}</h3>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {[{ label: f.ios_label, items: f.ios_items }, { label: f.android_label, items: f.android_items }].map((p) => (
        <div class="card-light p-5">
          <p class="font-display text-[1.1rem] font-semibold">{p.label}</p>
          <ul class="mt-2 space-y-1.5">
            {p.items.map((t) => <li class="flex gap-2"><span aria-hidden="true" class="text-leaf-dark">✓</span><span>{t}</span></li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-6 space-y-2 text-sm text-mint-light">
      <p>{f.premium_note}</p>
      <p>{f.ai_note}</p>
    </div>
  </div>
</section>
<style>.text-leaf-dark { color: #17733A; }</style>
