---
// Default: direct download, no email. Email capture is OFF by default
// (content/site.json → cheatsheet.email_capture.enabled) and uses an unchecked consent box.
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../lib/content.js';
import { isTBC } from '../lib/tbc.js';
import { withBase } from '../lib/paths.js';
const c = site.cheatsheet;
const e = c.email_capture;
const fileExists = fs.existsSync(path.join(process.cwd(), 'public', c.file));
const emailOn = e.enabled && !isTBC(e.form_action);
---
<section id="cheat-sheet" class="section bg-forest-2" aria-labelledby="cheat-title">
  <div class="wrap">
    <div class="card-light grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-10">
      <div>
        <p class="kicker !text-[#17733A]">{c.kicker}</p>
        <h2 id="cheat-title" class="section-title mt-2">{c.title}</h2>
        <p class="mt-2 max-w-[44ch]">{c.text}</p>
      </div>
      <div>
        {emailOn ? (
          <form action={e.form_action} method="post" class="grid gap-3 md:w-80" data-cheatsheet-form>
            <label class="grid gap-1 text-sm font-semibold">{e.email_label}
              <input type="email" name="email" required autocomplete="email" class="min-h-11 rounded-xl border-2 border-forest/30 bg-white px-3 text-base font-normal" />
            </label>
            <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="consent" required class="mt-1 size-4" /> <span>{e.consent_label}</span></label>
            <button type="submit" class="btn btn-forest">{e.submit}</button>
            <p class="text-xs">{e.privacy_note}</p>
          </form>
        ) : fileExists ? (
          <a href={withBase(c.file)} download class="btn btn-forest text-base" data-cheatsheet>{c.download}</a>
        ) : (
          <p><span class="btn btn-forest cursor-default opacity-70">{c.download}</span><br /><span class="tbc mt-2">{c.file_missing} [À CONFIRMER]</span></p>
        )}
      </div>
    </div>
  </div>
</section>
<style>.btn-forest { background: var(--color-forest); color: var(--color-ink); }</style>
<script>
  import { makeTracker } from '../lib/track.js';
  const track = makeTracker(JSON.parse(document.getElementById('analytics-config')?.textContent || '{}'));
  document.querySelector('[data-cheatsheet]')?.addEventListener('click', () => track('cheatsheet_download', { method: 'direct' }));
  document.querySelector('[data-cheatsheet-form]')?.addEventListener('submit', () => track('cheatsheet_download', { method: 'email' }));
</script>
