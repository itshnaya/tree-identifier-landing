---
// Series come from /content/series.json. TikTok's official embed loads only on click.
import Tbc from './Tbc.astro';
import { site, series } from '../lib/content.js';
import { isTBC } from '../lib/tbc.js';
import { showTBC } from '../lib/mode.js';
const w = site.watch;
const socials = Object.values(site.social).filter((s) => showTBC || !isTBC(s.url));
const videoId = (url) => (isTBC(url) ? null : (String(url).match(/\/video\/(\d+)/) || [])[1] || null);
---
<section id="watch" class="section section-light" aria-labelledby="watch-title">
  <div class="wrap">
    <h2 id="watch-title" class="section-title">{w.title}</h2>
    <p class="section-intro">{w.intro}</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {series.map((s) => {
        const id = videoId(s.tiktok_video_url);
        return (
          <li class="flex flex-col rounded-3xl bg-forest-2 p-5 text-ink">
            <h3 class="text-[1.45rem] font-bold text-mint">{s.title}</h3>
            <p class="mt-2 flex-1">{s.pitch}</p>
            <div class="mt-4" data-embed-slot>
              {id ? (
                <button type="button" class="btn btn-mint" data-tiktok-url={s.tiktok_video_url} data-tiktok-id={id} data-series={s.id} data-watch-label={w.watch_on_tiktok}>
                  <span aria-hidden="true">▶</span> {w.play_label}<span class="sr-only">: {s.title}</span>
                </button>
              ) : showTBC ? (
                <p class="text-sm text-mint-light">{w.no_video} <Tbc value={s.tiktok_video_url} /></p>
              ) : null}
            </div>
          </li>
        );
      })}
    </ul>
    {series.some((s) => videoId(s.tiktok_video_url)) && <p class="mt-3 text-sm text-moss">{w.embed_notice}</p>}
    {socials.length > 0 && <div class="mt-8 flex flex-wrap items-center gap-3">
      <span class="font-semibold">{w.follow_label}</span>
      {socials.map((s) => isTBC(s.url)
        ? <span class="btn btn-outline cursor-default text-sm">{s.label} <span class="tbc">[À CONFIRMER]</span></span>
        : <a class="btn btn-outline text-sm" href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
    </div>}
  </div>
</section>
<script>
  document.querySelectorAll('[data-tiktok-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slot = btn.closest('[data-embed-slot]');
      const bq = document.createElement('blockquote');
      bq.className = 'tiktok-embed';
      bq.setAttribute('cite', btn.dataset.tiktokUrl);
      bq.dataset.videoId = btn.dataset.tiktokId;
      bq.style.maxWidth = '605px'; bq.style.minWidth = '280px'; bq.style.margin = '0';
      const sec = document.createElement('section');
      const a = document.createElement('a'); a.href = btn.dataset.tiktokUrl; a.target = '_blank'; a.rel = 'noopener'; a.textContent = btn.dataset.watchLabel;
      sec.appendChild(a); bq.appendChild(sec);
      slot.replaceChildren(bq);
      // Official TikTok embed script, loaded once, only after a click.
      const s = document.createElement('script');
      s.src = 'https://www.tiktok.com/embed.js'; s.async = true;
      document.body.appendChild(s);
    });
  });
</script>
