---
// Hero: says in one glance what the app does (identify a tree from a photo),
// with a real app screen (official App Store visual, cropped) and the store badges.
import { Picture } from 'astro:assets';
import screen from '../assets/screens/step-3-care.png';
import StoreBadges from './StoreBadges.astro';
import { site } from '../lib/content.js';
const h = site.hero;
---
<section class="wrap grid items-center gap-8 pt-8 pb-14 md:grid-cols-[1.15fr_.85fr] md:gap-12 md:pt-16 md:pb-24" aria-labelledby="hero-title">
  <div>
    <p class="kicker">{h.kicker}</p>
    <h1 id="hero-title" class="mt-3 text-[2.4rem] font-bold tracking-[-0.01em] md:text-[3.9rem]">
      {h.title_line_1}<br /><span class="text-leaf-dark">{h.title_line_2}</span>
    </h1>
    <p class="mt-4 max-w-[38ch] text-[1.1rem] md:text-[1.25rem]">{h.subtitle}</p>
    <div class="mt-6"><StoreBadges size="lg" showIcon={false} source="hero" /></div>
    <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] text-muted">
      {h.facts.map((f) => <li class="flex items-center gap-2"><span aria-hidden="true" class="text-leaf-dark">✓</span>{f}</li>)}
    </ul>
  </div>
  <div class="mx-auto w-[min(70vw,280px)] md:w-full md:max-w-[340px]">
    <Picture src={screen} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[280, 420, 560, 680]} sizes="(min-width: 768px) 340px, 70vw"
      alt={h.screen_alt} loading="eager" fetchpriority="high"
      class="block aspect-[1287/1845] h-auto w-full rounded-[32px] border border-forest/10 shadow-[0_24px_50px_rgba(10,57,39,.18)]" />
  </div>
</section>
