---
// /get?s=<series>&p=<network>[&to=ios|android]
// iPhone → App Store (pt + ct), Android → Google Play (install referrer with UTM),
// desktop (or missing store link) → badges + QR code.
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { site } from '../lib/content.js';
import { withBase } from '../lib/paths.js';
import fs from 'node:fs';
// Inline the redirect logic (zero extra request before leaving for the store):
// the small ES modules are concatenated into one script, imports/exports removed.
const strip = (f) => fs.readFileSync(`src/lib/${f}`, 'utf8').replace(/^import .*$/gm, '').replace(/^export (?=(const|function|async))/gm, '');
const inlineRedirect = `(()=>{${['tbc.js', 'storeLinks.js', 'track.js', 'getRedirect.js'].map(strip).join('\n')}})();`;
const g = site.get_page;
const stores = {
  ios_url: site.stores.ios_url,
  android_url: site.stores.android_url,
  apple_provider_token: site.stores.apple_provider_token,
};
---
<Base title={g.title} noindex={true}>
  <main id="main" class="wrap grid min-h-svh place-items-center py-10 text-center">
    <div class="grid justify-items-center gap-5">
      <p data-get-redirecting class="font-display text-xl" aria-live="polite">{g.redirecting}</p>
      <div data-get-fallback hidden class="grid justify-items-center gap-5">
        <h1 class="text-[2rem] font-bold md:text-[2.6rem]">{g.desktop_title}</h1>
        <p class="max-w-[40ch] text-mint-light">{g.desktop_text}</p>
        <div data-get-qr class="rounded-3xl bg-ink p-4 empty:hidden" role="img" aria-label={g.qr_alt}></div>
        <StoreBadges source="get" />
        <a href={withBase('/')} class="underline">{g.back}</a>
      </div>
      <noscript><style>[data-get-redirecting]{display:none}[data-get-fallback]{display:grid!important}</style><p>{g.noscript}</p></noscript>
    </div>
    <script type="application/json" id="get-stores" set:html={JSON.stringify(stores)} />
    <script is:inline set:html={inlineRedirect} />
  </main>
</Base>
<script>
  // Desktop only: draw the QR code (loaded after the page, never on phones).
  if (document.documentElement.dataset.getPlatform === 'desktop') {
    import('qrcode-generator').then(({ default: qrcode }) => {
      const u = new URL(location.href); u.searchParams.delete('to');
      const qr = qrcode(0, 'M'); qr.addData(u.toString()); qr.make();
      const box = document.querySelector('[data-get-qr]');
      box.innerHTML = qr.createSvgTag({ cellSize: 6, margin: 2, scalable: true });
      const svg = box.querySelector('svg'); svg.setAttribute('aria-hidden', 'true'); svg.style.width = '200px';
    });
  }
</script>
